<mxfile host="Electron"><diagram name="Página-1" id="reto2-page"><mxGraphModel dx="754" dy="458" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" value="RETO 2 - De escenario a clases (Caso de uso: Consultar cupos)" vertex="1"><mxGeometry height="30" width="600" x="50" y="30" as="geometry"/></mxCell><mxCell id="actor_est" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;&amp;lt;&amp;lt;actor&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Estudiante" vertex="1"><mxGeometry height="80" width="40" x="80" y="150" as="geometry"/></mxCell><mxCell id="bound_pantalla" parent="1" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;fillStyle=auto;" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Pantalla Eventos" vertex="1"><mxGeometry height="70" width="80" x="240" y="155" as="geometry"/></mxCell><mxCell id="ctrl_calc" parent="1" style="ellipse;shape=umlControl;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Calcular Cupos" vertex="1"><mxGeometry height="70" width="70" x="460" y="155" as="geometry"/></mxCell><mxCell id="ent_evento" parent="1" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Evento" vertex="1"><mxGeometry height="70" width="70" x="690" y="100" as="geometry"/></mxCell><mxCell id="ent_reserva" parent="1" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Reserva" vertex="1"><mxGeometry height="70" width="70" x="690" y="240" as="geometry"/></mxCell><mxCell id="link_act_bnd" edge="1" parent="1" source="actor_est" style="endArrow=none;html=1;strokeWidth=2;rounded=0;" target="bound_pantalla"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="link_bnd_ctrl" edge="1" parent="1" source="bound_pantalla" style="endArrow=none;html=1;strokeWidth=2;rounded=0;" target="ctrl_calc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="link_ctrl_ev" edge="1" parent="1" source="ctrl_calc" style="endArrow=none;html=1;strokeWidth=2;rounded=0;" target="ent_evento"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="link_ctrl_res" edge="1" parent="1" source="ctrl_calc" style="endArrow=none;html=1;strokeWidth=2;rounded=0;" target="ent_reserva"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="box_calc" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;fontColor=#000000;strokeColor=#000000;align=left;verticalAlign=top;size=16;fontSize=11;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Justificación y cálculo del escenario (Concierto de Bienvenida):&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;margin-top: 4px; margin-bottom: 4px; padding-left: 20px;&quot;&gt;&lt;li&gt;&lt;b&gt;Aforo total del evento:&lt;/b&gt; 120 cupos.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cupos bloqueados organización:&lt;/b&gt; 5 (no reservables).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas confirmadas:&lt;/b&gt; 83 (ocupan cupo definitivo).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas pendientes vigentes:&lt;/b&gt; 12 (ocupan cupo provisional durante 10 min).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas canceladas:&lt;/b&gt; 7 (reportan como historial; no descuentan del aforo).&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Cálculo de cupos disponibles:&lt;/b&gt; 120 - (5 + 83 + 12) = &lt;b style=&quot;&quot;&gt;20 cupos disponibles&lt;/b&gt;." vertex="1"><mxGeometry height="150" width="680" x="80" y="370" as="geometry"/></mxCell><mxCell id="lbl_legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=middle;fontSize=11;" value="&lt;b&gt;Estereotipos BCE de Análisis (Jacobson / Schach):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Límite:&lt;/b&gt; Media entre actor y sistema.&lt;br&gt;• &lt;b&gt;Control:&lt;/b&gt; Coordina el cálculo del caso de uso.&lt;br&gt;• &lt;b&gt;Entidad:&lt;/b&gt; Información pasiva y persistente." vertex="1"><mxGeometry height="60" width="680" x="80" y="540" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>