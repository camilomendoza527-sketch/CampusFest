        <mxCell id="h-WP1Ckse3hXlNKijaXR-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214)); text-align: start; , rgb(41, 44, 48));&quot;&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 13px;&quot;&gt;1. EL organizador selecciona el evento&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 13px; , rgb(41, 44, 48));&quot;&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;2. Solicitar lista de reservas de un evento&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;3. Solicitar Información del evento&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;4. Revisar información de usuario con reserva&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;5.Devuelve usuarios registrados a evento seleccionado&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;6. Devuelve información a GestiónReserva&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;7. Calcular listado de reservas&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;8. Generar reporte de reservas&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;9. Generar &quot;reporte generado&quot;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;10. Generar &quot;reporte generado&quot;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;11a. &quot;Ok&quot;&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;span style=&quot; text-align: start;&quot;&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;, rgb(207, 210, 214));&quot;&gt;11b. Reporte&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/font&gt;" vertex="1">
