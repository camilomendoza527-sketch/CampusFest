        <mxCell id="note_ges" value="&lt;b&gt;¿Por qué hace falta otra clase de control (:Gestión Reserva)?&lt;/b&gt;&lt;br&gt;&lt;i&gt;CalcularDisponibilidad&lt;/i&gt; es una clase de consulta (read-only) cuyo único propósito es calcular cupos libres. &lt;b&gt;Crear y confirmar reservas&lt;/b&gt; es una operación transaccional de negocio que requiere:&lt;br&gt;1. Validar aforo y crear la reserva en estado &lt;i&gt;Pendiente&lt;/i&gt;.&lt;br&gt;2. Iniciar y monitorear el temporizador de 10 minutos.&lt;br&gt;3. Manejar la confirmación (transición a &lt;i&gt;Confirmada&lt;/i&gt;) o expiración (transición a &lt;i&gt;Vencida&lt;/i&gt; y liberación de cupo).&lt;br&gt;Separar ambas responsabilidades respeta el &lt;b&gt;Principio de Responsabilidad Única (SRP)&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;size=14;fontSize=10;" vertex="1" parent="sec1_box">
          <mxGeometry x="760" y="55" width="290" height="230" as="geometry" />
        </mxCell>
        
        
        <mxCell id="sec2_box" value="&lt;b&gt;Parte 2: Diagrama de Estados de la Entidad Reserva (UML State Machine)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#ffffff;fontColor=#000000;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1080" height="360" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_init" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="sec2_box">
          <mxGeometry x="60" y="110" width="26" height="26" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_pendiente" value="&lt;b&gt;Pendiente&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px;&quot;&gt;entry / ocupa cupo provisional&lt;br&gt;do / iniciar temporizador(10 min)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="sec2_box">
          <mxGeometry x="220" y="80" width="200" height="85" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_confirmada" value="&lt;b&gt;Confirmada&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px;&quot;&gt;entry / ocupa cupo definitivo&lt;br&gt;entry / generar código QR válido&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="sec2_box">
          <mxGeometry x="610" y="50" width="210" height="80" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_vencida" value="&lt;b&gt;Vencida&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px;&quot;&gt;entry / libera cupo provisional&lt;br&gt;entry / registrar en historial&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="sec2_box">
          <mxGeometry x="610" y="160" width="210" height="70" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_cancelada" value="&lt;b&gt;Cancelada&lt;/b&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;font-size: 10px;&quot;&gt;entry / libera cupo (si ocupaba)&lt;br&gt;entry / reportar como historial&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="sec2_box">
          <mxGeometry x="610" y="260" width="210" height="70" as="geometry" />
        </mxCell>
        
        
        <mxCell id="st_final" value="" style="ellipse;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="sec2_box">
          <mxGeometry x="960" y="165" width="28" height="28" as="geometry" />
        </mxCell>
        
        
        
        <mxCell id="tr_init_pend" value="Crear reserva ()&lt;br&gt;[aforo disponible]" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=10;fontColor=#000000;" edge="1" parent="sec2_box" source="st_init" target="st_pendiente">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="tr_pend_conf" value="confirmarReserva () [tiempo &amp;lt;= 10 min]&lt;br&gt;/ detener temporizador" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=10;fontColor=#000000;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sec2_box" source="st_pendiente" target="st_confirmada">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="tr_pend_venc" value="timeout (10 min sin confirmar)&lt;br&gt;/ liberar cupo" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=10;fontColor=#000000;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="sec2_box" source="st_pendiente" target="st_vencida">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="tr_pend_canc" value="cancelarReserva () [por estudiante]&lt;br&gt;/ liberar cupo" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=10;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="sec2_box" source="st_pendiente" target="st_cancelada">
