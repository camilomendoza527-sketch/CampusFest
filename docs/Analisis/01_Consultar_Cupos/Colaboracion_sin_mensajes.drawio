        <mxCell id="title" value="RETO 2 - De escenario a clases (Caso de uso: Consultar cupos)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="600" height="30" as="geometry" />
        </mxCell>
        
        
