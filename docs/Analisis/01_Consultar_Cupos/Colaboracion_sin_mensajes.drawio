        <mxCell id="ent_reserva" value="&lt;b&gt;&amp;lt;&amp;lt;entidad&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Reserva" style="ellipse;shape=umlEntity;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="690" y="240" width="70" height="70" as="geometry" />
        </mxCell>
        
        
        <mxCell id="link_act_bnd" edge="1" parent="1" source="actor_est" target="bound_pantalla" style="endArrow=none;html=1;strokeWidth=2;rounded=0;">
