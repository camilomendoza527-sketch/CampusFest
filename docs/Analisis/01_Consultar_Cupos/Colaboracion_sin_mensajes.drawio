        </mxCell>
        
        <mxCell id="link_ctrl_res" edge="1" parent="1" source="ctrl_calc" target="ent_reserva" style="endArrow=none;html=1;strokeWidth=2;rounded=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        
        <mxCell id="box_calc" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Justificación y cálculo del escenario (Concierto de Bienvenida):&lt;/b&gt;&lt;br&gt;&lt;ul style=&quot;margin-top: 4px; margin-bottom: 4px; padding-left: 20px;&quot;&gt;&lt;li&gt;&lt;b&gt;Aforo total del evento:&lt;/b&gt; 120 cupos.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Cupos bloqueados organización:&lt;/b&gt; 5 (no reservables).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas confirmadas:&lt;/b&gt; 83 (ocupan cupo definitivo).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas pendientes vigentes:&lt;/b&gt; 12 (ocupan cupo provisional durante 10 min).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Reservas canceladas:&lt;/b&gt; 7 (reportan como historial; no descuentan del aforo).&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Cálculo de cupos disponibles:&lt;/b&gt; 120 - (5 + 83 + 12) = &lt;b style=&quot;&quot;&gt;20 cupos disponibles&lt;/b&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;fontColor=#000000;strokeColor=#000000;align=left;verticalAlign=top;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="680" height="150" as="geometry" />
        </mxCell>
        
        
        <mxCell id="lbl_legend" value="&lt;b&gt;Estereotipos BCE de Análisis (Jacobson / Schach):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Límite:&lt;/b&gt; Media entre actor y sistema.&lt;br&gt;• &lt;b&gt;Control:&lt;/b&gt; Coordina el cálculo del caso de uso.&lt;br&gt;• &lt;b&gt;Entidad:&lt;/b&gt; Información pasiva y persistente." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="680" height="60" as="geometry" />
        </mxCell>
