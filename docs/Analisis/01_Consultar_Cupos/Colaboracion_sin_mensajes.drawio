          <mxGeometry x="80" y="150" width="40" height="80" as="geometry" />
        </mxCell>
        
        
        <mxCell id="bound_pantalla" value="&lt;b&gt;&amp;lt;&amp;lt;límite&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;:Pantalla Eventos" style="shape=umlBoundary;whiteSpace=wrap;html=1;verticalAlign=top;verticalLabelPosition=bottom;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
